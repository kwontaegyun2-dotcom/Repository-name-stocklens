[Unit]
Description=stocklens 주식 분석 웹앱
After=network.target

[Service]
Type=simple
User=stocklens
WorkingDirectory=/opt/stocklens
ExecStart=/opt/stocklens/venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8767
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=STOCKLENS_PUBLIC=1
Environment=STOCKLENS_DATA_DIR=/opt/stocklens-data

[Install]
WantedBy=multi-user.target
